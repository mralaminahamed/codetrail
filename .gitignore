# Env / secrets. .env alone does not match .env.local, and P7 is the phase that
# introduces this project's first API key. Nothing here reads a .env file —
# config is os.LookupEnv and nothing else — so the pattern exists to stop one
# being committed by a hand that assumes otherwise. The example is exempt so a
# deployment can carry one.
.env*
!.env.example

# Terraform. Three artifacts hold secrets in cleartext, not one: the plan file,
# the show -json output CI generates from it (which carries the assembled
# DATABASE_URL, password included, as a planned attribute), and state, which
# holds aws_db_instance.password and every secret version for as long as the
# stack exists. None of them is ever a workflow artifact or a log line.
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*
.terraform/
tfplan
tfplan.json
backend.hcl

# Build output
/bin/
/out/
/cmd

# Web
node_modules/
dist/
.vite/

# Planning docs (kept untracked)
PLAN.md
docs/plan-*.md

# Repos cloned for indexing
/.cache/

# OS / editor
.DS_Store
*.swp

# SDD workspace (git-ignored scratch)
.superpowers/
backend_override.tf

# Eval artefacts (mechanics runs are not measurements)
docs/eval/mechanics/
